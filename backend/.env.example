# Local-only secret file. Copy this file to backend/.env and add the API key there.
# STEELSHIELD_LLM_BASE_URL may be any HTTPS gateway URL.
STEELSHIELD_LLM_API_KEY=
STEELSHIELD_LLM_BASE_URL=https://your-llm-gateway.example/api
STEELSHIELD_LLM_MODEL=gpt-5.6-sol
STEELSHIELD_LLM_REVIEW_MODEL=gpt-5.6-sol
STEELSHIELD_LLM_REASONING_EFFORT=xhigh
STEELSHIELD_LLM_STORE=false
STEELSHIELD_LLM_TIMEOUT_S=60
STEELSHIELD_LIVE_LLM=0
REDIS_URL=redis://127.0.0.1:6379/0
# One active worker is enforced with this Redis lease duration.
STEELSHIELD_WORKER_LOCK_TTL_SEC=60
